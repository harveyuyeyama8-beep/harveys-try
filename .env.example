# Local development only. Copy to .dev.vars (which is gitignored) so
# `wrangler pages dev` can read them.
#
# In production these are NOT files. They go in the Cloudflare dashboard:
#   Workers & Pages → harveys-try → Settings → Variables and Secrets
# Anything below marked SECRET must be added with the "Secret" type, which
# encrypts it and hides it from the dashboard afterwards.

# SECRET — Meta Conversions API access token, generated in Events Manager.
META_ACCESS_TOKEN=

# Not secret, but keep it out of the repo anyway so test and live can differ.
META_PIXEL_ID=

# Graph API version. Check Meta's changelog and bump it once a year;
# old versions are sunset roughly two years after release.
META_API_VERSION=v25.0

# Optional: while testing, paste the code from Events Manager → Test Events
# so events land in the test view instead of your real reporting.
META_TEST_EVENT_CODE=

# Optional: set this and every /go link becomes a self-applying discount link.
DISCOUNT_CODE=
