# Copy to adintel/.env. Never commit the real file.

# Claude — decomposition, persona agents, remix strategist.
ANTHROPIC_API_KEY=

# Jev (TypeSafe AI) — every cheap decision: relevance, labels, rubric scores, persona probabilities.
TYPESAFE_API_KEY=

# Ad library source (config.json → harvest.source).
# apify: full US creative incl. images, video, CTA, landing URL, collation_count.
APIFY_TOKEN=
# meta: official Ad Library API (EU/UK-delivered commercial ads only). Needs an identity-verified user token.
META_ADLIB_TOKEN=

# Optional: transcribe video hooks (config.json → harvest.transcribeVideos = true).
OPENAI_API_KEY=
