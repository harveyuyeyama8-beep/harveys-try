---
/** A 2x2 grid of short benefit cards, each with a small bean mark. */
interface Props {
  heading?: string;
  items: { title: string; body: string }[];
}
const { heading, items } = Astro.props;
---

{heading && <h2>{heading}</h2>}
<div class="benefits">
  {items.map((b) => (
    <div class="benefit">
      <h3>
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M17.6 3.4c-3.2-2.2-8.2-.9-11.3 3S3 15.4 6.2 17.6s8.2.9 11.3-3 3.3-9 .1-11.2zm-2.3 2.1c-.5 1.8-2 3-3.9 4.1-2 1.2-3.9 2.5-4.6 5.4-1.1-1.8-.7-4.7 1.2-7.2 2-2.6 4.9-3.7 7.3-2.3zM8.7 15.5c.5-1.8 2-3 3.9-4.1 2-1.2 3.9-2.5 4.6-5.4 1.1 1.8.7 4.7-1.2 7.2-2 2.6-4.9 3.7-7.3 2.3z"/>
        </svg>
        {b.title}
      </h3>
      <p>{b.body}</p>
    </div>
  ))}
</div>
