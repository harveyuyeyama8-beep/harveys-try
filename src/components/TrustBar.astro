---
/**
 * Credibility strip that sits directly under the article header:
 *
 *     ───────  As Seen In  ───────
 *      [logo]   [logo]   [logo]
 *        A bold line of social proof
 *          a quieter line under it
 *              ★★★★★
 *
 * Every part is optional. Leave a field out and that row simply doesn't
 * render, so the same block can be a bare logo row or the full stack.
 */
import { pressLogo } from '../press';

interface Props {
  label?: string;
  logos?: string[];
  heading?: string;
  proof?: string;
  stars?: number;
}
const { label, logos = [], heading, proof, stars = 0 } = Astro.props;

const resolved = logos.map((k) => pressLogo(k)).filter((l) => l !== null);
---

<div class="trustbar">
  {label && (
    <p class="tb-label"><span>{label}</span></p>
  )}

  {resolved.length > 0 && (
    <div class="tb-logos">
      {resolved.map((l) => (
        <img src={l!.src} alt={l!.name} height={l!.height} style={`height:${l!.height}px`} loading="lazy" decoding="async" />
      ))}
    </div>
  )}

  {heading && <p class="tb-heading">{heading}</p>}
  {proof && <p class="tb-proof">{proof}</p>}

  {stars > 0 && (
    <p class="tb-stars" aria-label={`${stars} out of 5 stars`}>{'★'.repeat(stars)}</p>
  )}
</div>
