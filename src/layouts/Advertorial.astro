---
import { marked } from 'marked';
import { site } from '../site.config';
import '../styles/theme.css';

import Cta from '../components/Cta.astro';
import PhotoSlot from '../components/PhotoSlot.astro';
import Compare from '../components/Compare.astro';
import Steps from '../components/Steps.astro';
import QuizCard from '../components/QuizCard.astro';
import PressStrip from '../components/PressStrip.astro';
import Reviews from '../components/Reviews.astro';
import Faq from '../components/Faq.astro';
import TrustBar from '../components/TrustBar.astro';
import StickyBar from '../components/StickyBar.astro';
import Analytics from '../components/Analytics.astro';
import Reason from '../components/Reason.astro';
import OfferCard from '../components/OfferCard.astro';
import Benefits from '../components/Benefits.astro';
import Coverage from '../components/Coverage.astro';
import FactBox from '../components/FactBox.astro';

const { entry } = Astro.props;
const d = entry.data;

/* Three shells share one block loop. `article` is the long-read; `story` is
   the listicle shell (offer strip, dark masthead with a button, centered
   headline over a hero image, alternating cream/white bands); `news` is the
   news-feature shell (white page, section-name masthead, serif headline,
   captioned hero photo, one 600px column, news footer). Everything
   shell-specific is gated on these flags so the other pages render exactly
   as before. */
const isStory = d.format === 'story';
const isNews = d.format === 'news';

/* Blocks that sit in the narrow reading column. Photos, the press strip,
   myth rows and the offer card break out of it, which is what gives the
   page its rhythm. */
const NARROW = new Set(['prose', 'pullquote', 'compare', 'steps', 'quizcard', 'cta', 'reviews', 'faq', 'trustbar', 'benefits', 'coverage', 'factbox']);

/* CTA positions are numbered in document order — cta-1, cta-2 … — so the
   `utm_content` and the Analytics Engine rows tell you which one earned
   the click. In the story shell the masthead button is cta-1, so the blocks
   start counting from 2. The news shell has no button above the story. */
let ctaCount = isStory ? 1 : 0;
let photoCount = 0;
let reasonCount = 0;

const goHref = (position: string) =>
  `/go?to=${encodeURIComponent(d.cta.destination)}` +
  `&pos=${encodeURIComponent(position)}` +
  `&pg=${encodeURIComponent(entry.id)}`;

/* Story shell: the blocks are grouped into full-width bands. A band starts
   at every block that carries a heading (a myth row, the offer card, a
   headed prose or benefits block); the blocks after it — photos, unheaded
   prose, the final CTA — stay in that band. Bands alternate cream / white,
   starting on cream under the white hero. The article and news shells are
   one band. */
const startsBand = (b: any) =>
  isStory && (
    b.type === 'reason' ||
    b.type === 'offercard' ||
    ((b.type === 'prose' || b.type === 'benefits') && b.heading)
  );
/* In the story and news shells a trust bar placed FIRST renders inside the
   header rather than at the top of the body: under the hero image (story),
   or under the date line as the "As Seen On" band (news). */
const leadTrust = (isStory || isNews) && d.blocks[0]?.type === 'trustbar' ? d.blocks[0] : null;
const bodyBlocks = leadTrust ? d.blocks.slice(1) : d.blocks;

const bands: any[][] = [[]];
for (const block of bodyBlocks) {
  if (startsBand(block) && bands[bands.length - 1].length) bands.push([]);
  bands[bands.length - 1].push(block);
}

/* Dates are stored as midnight UTC, so they are formatted in UTC; a local
   time zone would show the day before. The news shell uses AP style
   ("Sept. 23, 2026"), the way a newspaper prints it. */
const AP_MONTHS = ['Jan.', 'Feb.', 'March', 'April', 'May', 'June', 'July', 'Aug.', 'Sept.', 'Oct.', 'Nov.', 'Dec.'];
const dateStr = d.date
  ? isNews
    ? `${AP_MONTHS[d.date.getUTCMonth()]} ${d.date.getUTCDate()}, ${d.date.getUTCFullYear()}`
    : new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(d.date)
  : null;

/* The news footer links only to the policies and the support address. The
   store and quiz links in site.footerLinks would be untracked CTAs. */
const policyLinks = site.footerLinks.filter((l) => l.href.includes('/policies/'));
const year = (d.date ?? new Date()).getUTCFullYear();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <title>{d.title}</title>
  <meta name="description" content={d.description} />
  <link rel="canonical" href={new URL(Astro.url.pathname, site.url).href} />
  {d.noindex && <meta name="robots" content="noindex, follow" />}

  <meta property="og:type" content="article" />
  <meta property="og:title" content={d.headline} />
  <meta property="og:description" content={d.description} />
  <meta property="og:image" content={new URL(d.ogImage, site.url).href} />
  <meta property="og:url" content={new URL(Astro.url.pathname, site.url).href} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  {isNews ? (
    <link
      href="https://fonts.googleapis.com/css2?family=Frank+Ruhl+Libre:wght@300;700&family=Libre+Franklin:wght@400;500;700;800&family=Gelasio:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  ) : (
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap"
      rel="stylesheet"
    />
  )}
  {(isStory || isNews) && d.heroImage && <link rel="preload" as="image" href={d.heroImage} />}
</head>

<body class:list={{ 'story-page': isStory, 'news-page': isNews }}>
  {!isNews && <div id="progress"></div>}

  {isStory && d.offerStrip && <p class="offer-strip">{d.offerStrip}</p>}

  {isNews ? (
    <div class="news-masthead">
      <p class="nm-section">{d.section ?? ''}</p>
    </div>
  ) : (
    <div class="masthead">
      <div class="wrap-wide">
        <a class="brand" href={site.storeUrl}>Harvey&apos;s Coffee</a>
        {isStory && (
          <a class="btn masthead-btn" href={goHref('cta-1')} data-cta="cta-1" rel="noopener">{d.cta.button}</a>
        )}
      </div>
    </div>
  )}

  {isNews ? (
    <header class="news-head">
      <div class="wrap">
        {d.kicker && <p class="kicker">{d.kicker}</p>}
        <h1>{d.headline}</h1>
        {d.dek && <p class="dek">{d.dek}</p>}
      </div>

      {d.heroImage && (
        <figure class="news-hero">
          <img src={d.heroImage} alt={d.heroAlt} width="1200" height="800" fetchpriority="high" decoding="async" />
          {(d.heroCaption || d.heroCredit) && (
            <figcaption>
              {d.heroCaption}
              {d.heroCredit && <span class="credit">{d.heroCredit}</span>}
            </figcaption>
          )}
        </figure>
      )}

      <div class="wrap">
        <div class="news-meta">
          <p class="news-date">
            {d.label && <span class="news-label">{d.label}</span>}
            {d.author && <span class="news-by">By {d.author}</span>}
            {dateStr && <time datetime={d.date!.toISOString().slice(0, 10)}>{dateStr}</time>}
            {dateStr && d.readingTime && <span aria-hidden="true"> · </span>}
            {d.readingTime && <span>{d.readingTime}</span>}
          </p>
          <button type="button" class="news-share" data-share>Share</button>
        </div>

        {leadTrust && (
          <TrustBar label={leadTrust.label} logos={leadTrust.logos} heading={leadTrust.heading} proof={leadTrust.proof} stars={leadTrust.stars} />
        )}
      </div>
    </header>
  ) : isStory ? (
    <header class="story-hero">
      <div class="wrap-wide">
        {d.kicker && <p class="kicker">{d.kicker}</p>}
        <h1>{d.headline}</h1>
        {d.dek && <p class="dek">{d.dek}</p>}
        {d.heroImage && (
          <img class="hero-img" src={d.heroImage} alt={d.heroAlt} width="1600" height="800" fetchpriority="high" decoding="async" />
        )}
        {leadTrust && (
          <TrustBar label={leadTrust.label} logos={leadTrust.logos} heading={leadTrust.heading} proof={leadTrust.proof} stars={leadTrust.stars} />
        )}
      </div>
    </header>
  ) : (
    <header class="article">
      <div class="wrap">
        {d.kicker && <p class="kicker">{d.kicker}</p>}
        <h1>{d.headline}</h1>
        {d.dek && <p class="dek">{d.dek}</p>}

        <div class="byline">
          {d.author && <span>By <strong>{d.author}</strong></span>}
          {d.author && dateStr && <span class="dot"></span>}
          {dateStr && <span>{dateStr}</span>}
          {dateStr && d.readingTime && <span class="dot"></span>}
          {d.readingTime && <span>{d.readingTime}</span>}
        </div>
      </div>
    </header>
  )}

  <main>
    {bands.map((blocks, bandIndex) => {
      const rendered = blocks.map((block: any) => {
        const inner = (() => {
          switch (block.type) {
            case 'prose':
              return (
                <>
                  {block.heading && <h2>{block.heading}</h2>}
                  <div class={block.lead ? 'prose lead-wrap' : 'prose'} set:html={marked.parse(block.body)} />
                </>
              );

            case 'pullquote':
              return block.cite ? (
                <figure class="pull-fig">
                  <blockquote class="pull">&ldquo;{block.text}&rdquo;</blockquote>
                  <figcaption class="pull-cite">{block.cite}</figcaption>
                </figure>
              ) : (
                <p class="pull">{block.text}</p>
              );

            case 'reason':
              reasonCount += 1;
              return (
                <Reason
                  number={block.number}
                  heading={block.heading}
                  lead={block.lead}
                  body={block.body}
                  image={block.image}
                  alt={block.alt}
                  flip={reasonCount % 2 === 0}
                />
              );

            case 'offercard':
              ctaCount += 1;
              return (
                <OfferCard
                  image={block.image}
                  alt={block.alt}
                  badge={block.badge}
                  heading={block.heading}
                  subheading={block.subheading}
                  body={block.body}
                  fine={block.fine}
                  button={d.cta.button}
                  destination={d.cta.destination}
                  position={`cta-${ctaCount}`}
                  page={entry.id}
                />
              );

            case 'benefits':
              return <Benefits heading={block.heading} items={block.items} />;

            case 'trustbar':
              return <TrustBar label={block.label} logos={block.logos} heading={block.heading} proof={block.proof} stars={block.stars} />;

            case 'cta':
              ctaCount += 1;
              return (
                <Cta cta={d.cta} offer={block.offer} note={block.note} position={`cta-${ctaCount}`} page={entry.id} variant={block.variant} />
              );

            case 'compare':
              return (
                <Compare
                  label={block.label}
                  themHeading={block.themHeading}
                  usHeading={block.usHeading}
                  rows={block.rows}
                />
              );

            case 'steps':
              return <Steps items={block.items} />;

            case 'quizcard':
              return (
                <QuizCard
                  heading={block.heading}
                  time={block.time}
                  questions={block.questions}
                  footnote={block.footnote}
                />
              );

            case 'reviews':
              return <Reviews heading={block.heading} items={block.items} />;

            case 'faq':
              return <Faq heading={block.heading} items={block.items} />;

            case 'coverage':
              return <Coverage label={block.label} items={block.items} />;

            case 'factbox':
              return <FactBox heading={block.heading} items={block.items} note={block.note} />;

            case 'photo':
              photoCount += 1;
              return (
                <PhotoSlot
                  src={block.src}
                  alt={block.alt}
                  caption={block.caption}
                  credit={block.credit}
                  shape={block.shape}
                  width={block.width}
                  note={block.note}
                  index={photoCount}
                />
              );

            case 'press':
              return <PressStrip label={block.label} items={block.items} />;

            default:
              return null;
          }
        })();

        return NARROW.has(block.type) ? <div class="wrap">{inner}</div> : inner;
      });

      return isStory
        ? <section class:list={['band', bandIndex % 2 === 0 ? 'band-cream' : 'band-white']}>{rendered}</section>
        : rendered;
    })}
  </main>

  {isNews && (
    <footer class="news-footer">
      <p class="nf-disclosure">{site.legal}</p>
      <div class="nf-inner">
        <nav aria-label="Policies">
          {policyLinks.map((l) => <a href={l.href}>{l.text}</a>)}
          <a href={`mailto:${site.contactEmail}`}>Contact</a>
        </nav>
        <p class="nf-copy">&copy; {year} {site.name} · {site.location}</p>
      </div>
    </footer>
  )}

  {d.sticky && (
    <StickyBar
      title={d.sticky.title}
      sub={d.sticky.sub}
      button={d.cta.button}
      destination={d.cta.destination}
      page={entry.id}
    />
  )}

  <Analytics />

  {isNews && (
    <script is:inline>
      /* The Share button: the phone's own share sheet where there is one,
         otherwise copy the clean page URL (no ad-click parameters). */
      document.querySelectorAll('[data-share]').forEach(function (b) {
        b.addEventListener('click', function () {
          var link = document.querySelector('link[rel=canonical]');
          var url = link ? link.href : location.origin + location.pathname;
          if (navigator.share) {
            navigator.share({ title: document.title, url: url }).catch(function () {});
            return;
          }
          if (navigator.clipboard) {
            navigator.clipboard.writeText(url).then(function () {
              b.textContent = 'Link copied';
              setTimeout(function () { b.textContent = 'Share'; }, 2000);
            }).catch(function () {});
          }
        });
      });
    </script>
  )}

  <noscript>
    <div class="wrap">
      <div class="cta">
        <p class="cta-offer">Find your coffee</p>
        <a class="btn" href={site.storeUrl + site.quizPath}>{d.cta.button}</a>
      </div>
    </div>
  </noscript>
</body>
</html>
